FRONTEND_PORT=5173
BACKEND_PORT=8080
POSTGRES_DB=utc_rag
POSTGRES_USER=utc
POSTGRES_PASSWORD=change-me
POSTGRES_WORKER_USER=utc_worker
POSTGRES_WORKER_PASSWORD=change-me-worker
SLM_MODEL=qwen3:0.6b
EMBEDDING_MODEL=embeddinggemma:300m-qat-q4_0
# Fixed architecture contract: embedding dimension is 768.
UTC_SOURCE_URL=https://tuyensinh.utc.edu.vn/
CURSOR_SECRET=change-me-to-at-least-32-random-characters
SESSION_COOKIE_SECURE=false
OLLAMA_CONNECT_TIMEOUT=5s
OLLAMA_READ_TIMEOUT=120s
LOGIN_MAX_FAILURES=5
LOGIN_WINDOW_SECONDS=900
CHAT_PER_MINUTE=10
SCORES_PER_MINUTE=30
UPLOADS_PER_MINUTE=10
JOBS_PER_MINUTE=10

# Crawler & Scheduler Configuration
CRAWLER_USER_AGENT=UTC-RAG-Crawler/1.0
CRAWLER_RATE_LIMIT=2.0
CRAWLER_TIMEOUT=30
CRAWLER_MAX_RETRIES=3
CRAWLER_MAX_REDIRECTS=5
CRAWLER_MAX_CONTENT_MB=50
CRAWLER_RESPECT_ROBOTS=true
CRAWLER_AUTO_PUBLISH=true
CRAWLER_ENABLE_OCR=false
CRAWLER_OCR_LANGUAGES=vi,en
CRAWLER_OCR_USE_GPU=false
CRAWLER_OCR_MIN_CONFIDENCE=0.3

# Worker Lease / Retry Configuration
WORKER_LEASE_DURATION_SECONDS=600
WORKER_HEARTBEAT_INTERVAL_SECONDS=120
JOB_MAX_ATTEMPTS=3
JOB_RETRY_BASE_DELAY_SECONDS=900
JOB_RETRY_MAX_DELAY_SECONDS=21600
JOB_RETRY_JITTER_RATIO=0.2

# Scheduler Timing Configuration
SCHEDULER_CHECK_INTERVAL_SECONDS=300
SCHEDULER_DEFAULT_INTERVAL_HOURS=6
